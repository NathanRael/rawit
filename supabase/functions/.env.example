# Used only by local Supabase Edge Function development. Do not put these in the Expo app env file.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=RAWIT reminders
# A long random string. Use the same value in Supabase Vault as rawit_cron_secret.
RAWIT_CRON_SECRET=replace-with-a-long-random-secret
