  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "lightningcss": "1.30.1",
    "postcss": "8.5.30",
    "supabase": "^2.121.0",
    "tailwindcss": "4.1.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "env:init:local": "node scripts/init-env.mjs local",
    "env:init:prod": "node scripts/init-env.mjs production",
    "start": "node scripts/run-expo-env.mjs local start",
    "start:prod": "node scripts/run-expo-env.mjs production start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node scripts/run-expo-env.mjs local start --android",
    "ios": "node scripts/run-expo-env.mjs local start --ios",
    "web": "node scripts/run-expo-env.mjs local start --web",
    "export:prod": "node scripts/run-expo-env.mjs production export --platform all",
    "build": "pnpm export:prod",
    "lint": "node scripts/run-expo-env.mjs local lint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "node --test src/lib/dates/index.test.mjs src/lib/overview.test.mjs",
    "verify": "pnpm check && pnpm test && pnpm build",
    "supabase:login": "supabase login",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:link": "supabase link",
    "supabase:db:push": "supabase db push",
    "supabase:db:pull": "supabase db pull",
    "supabase:db:diff": "supabase db diff",
    "supabase:migration:new": "supabase migration new",
    "supabase:function:serve": "supabase functions serve --env-file supabase/functions/.env",
    "supabase:function:deploy": "supabase functions deploy send-reminder-email && supabase functions deploy dispatch-reminder-emails",
    "supabase:email:dispatch:local": "node scripts/dispatch-reminder-emails.mjs",
    "supabase:cron:setup": "supabase db query --linked --file supabase/cron/setup.sql",
    "supabase:secrets:set": "supabase secrets set --env-file supabase/functions/.env",
    "supabase:secrets:list": "supabase secrets list"
  },
  "private": true
}
